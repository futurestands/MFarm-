<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <!-- Search Bar -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearchDisease"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="🔎 Search disease or symptom (e.g., fever, diarrhea, swelling)..."
            android:imeOptions="actionSearch"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Quick Action Buttons: Symptom Checker & Preventive Care -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnOpenSymptomChecker"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="🔎 CHECK SYMPTOMS"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnTogglePreventiveCare"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="🛡️ PREVENTIVE CARE"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Preventive Care Section (Initially Hidden) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/layoutPreventiveCare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardCornerRadius="10dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="#E8F5E9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ FARM PREVENTIVE CARE &amp; BIOSECURITY GUIDE"
                android:textColor="#2E7D32"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Tick Control: Dip or spray cattle regularly with approved acaricides to prevent ECF, Anaplasmosis, and Babesiosis.\n\n• Worm Control: Deworm cattle before and after the wet season using broad-spectrum anthelmintics.\n\n• Vaccination Schedule: Maintain annual herd vaccinations for Blackleg, Anthrax, LSD, and FMD as advised by MAAIF.\n\n• Nutrition &amp; Clean Water: Provide fresh clean water and balanced mineral licks to maintain strong immune defense.\n\n• Clean Milking Hygiene: Wash teats with clean water, use post-milking teat dip, and milk infected cows last.\n\n• Quarantine &amp; Biosecurity: Isolate newly purchased cattle for 30 days. Spray new stock for ticks before introducing to herd.\n\n• Carcass Handling: DO NOT open carcasses of animals that die suddenly. Bury deeply with quicklime or burn."
                android:textColor="#1B5E20"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Emergency Banner Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardEmergency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="#FFEBEE">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 CRITICAL EMERGENCY / RED FLAGS"
                android:textColor="#C62828"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap a red-flag condition for immediate emergency guidelines:"
                android:textColor="#B71C1C"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4">

                <Button
                    android:id="@+id/btnEmergencyAnthrax"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔴 Anthrax"
                    android:textColor="#B71C1C"
                    android:textSize="10sp"
                    android:paddingHorizontal="2dp" />

                <Button
                    android:id="@+id/btnEmergencyRabies"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔴 Rabies"
                    android:textColor="#B71C1C"
                    android:textSize="10sp"
                    android:paddingHorizontal="2dp" />

                <Button
                    android:id="@+id/btnEmergencyFMD"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔴 FMD"
                    android:textColor="#B71C1C"
                    android:textSize="10sp"
                    android:paddingHorizontal="2dp" />

                <Button
                    android:id="@+id/btnEmergencyCBPP"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔴 CBPP"
                    android:textColor="#B71C1C"
                    android:textSize="10sp"
                    android:paddingHorizontal="2dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvGuideHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="COMMON LIVESTOCK DISEASES &amp; GUIDES"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/colorPrimary"
        android:layout_marginBottom="8dp" />

</LinearLayout>
