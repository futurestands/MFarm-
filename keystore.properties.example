# Keystore Configuration Template
# Copy this file to keystore.properties and fill in your client release signing values.
# DO NOT commit keystore.properties or keystore files (*.jks) to version control.

KEYSTORE_FILE=../keystore/mfarm-release.jks
KEYSTORE_PASSWORD=your_keystore_password_here
KEY_ALIAS=your_key_alias_here
KEY_PASSWORD=your_key_password_here
